DJANGO_DEBUG=true
# Production: list only additional custom domains here. Vercel deployment,
# branch and production hostnames are added from Vercel system variables.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Generate a local secret as described in README; never commit .env.
DJANGO_SECRET_KEY=
# Private server key: enable Places Search and Routing.
TOMTOM_API_KEY=
# Intentionally public browser key: map display only, with domain restrictions.
TOMTOM_MAP_KEY=
PLAN_MAX_DAYS=30
PLAN_MAX_FACILITIES=100
PLAN_MAX_REQUESTS=100
PLAN_TIMEOUT_SECONDS=120
